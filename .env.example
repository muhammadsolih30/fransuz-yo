# ─── Appwrite (asosiy backend — barcha qurilmalarda arizalar uchun MAJBURIY) ───
# Cloud: https://cloud.appwrite.io
# Agar "Project is paused due to inactivity" chiqsa — Console'da Restore bosing.
# Collection permissions: Create + Read + Update + Delete → Any / Guests
VITE_APPWRITE_ENDPOINT=https://nyc.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT=PROJECT_ID
VITE_APPWRITE_DB=DATABASE_ID
VITE_APPWRITE_COLLECTION=COLLECTION_ID

# Collection attributes (string): ism, telefon, telegram, country, format, daraja, xabar, status, scheduledDate, checkedAt
#
# MUHIM — Web Platforms (CORS):
# Appwrite Console → Overview → Platforms → Add platform → Web
# Hostname: fransuz-yo.uz
# Hostname: www.fransuz-yo.uz
# Hostname: fransuz-yo.vercel.app
# (Production endi /api/leads proxy orqali ham ishlaydi, lekin Platforms qo'shish tavsiya etiladi)

# ─── Supabase (ixtiyoriy alternativ) ───
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
