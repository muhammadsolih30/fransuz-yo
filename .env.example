# ─── Appwrite (asosiy backend — barcha qurilmalarda arizalar uchun MAJBURIY) ───
# Cloud: https://cloud.appwrite.io
# Collection permissions: Create + Read + Update + Delete → Any / Guests
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT=PROJECT_ID
VITE_APPWRITE_DB=DATABASE_ID
VITE_APPWRITE_COLLECTION=COLLECTION_ID

# Collection attributes (string): ism, telefon, telegram, country, format, daraja, xabar, status, scheduledDate, checkedAt

# ─── Supabase (ixtiyoriy alternativ) ───
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
