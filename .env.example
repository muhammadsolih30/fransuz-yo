# ─── Neon Postgres (asosiy backend — barcha qurilmalarda arizalar) ───
# Console: https://console.neon.tech
# 1) Yangi project yarating
# 2) SQL Editor'da sql/leads.sql ni ishga tushiring
# 3) Connection string ni oling (Dashboard → Connection details → Connection string)
# 4) Vercel → Project → Settings → Environment Variables ga qo'shing:
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# ─── Appwrite (ixtiyoriy, eski zaxira — localhost uchun) ───
# Cloud: https://cloud.appwrite.io
VITE_APPWRITE_ENDPOINT=
VITE_APPWRITE_PROJECT=
VITE_APPWRITE_DB=
VITE_APPWRITE_COLLECTION=

# ─── Supabase (ixtiyoriy alternativ) ───
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
